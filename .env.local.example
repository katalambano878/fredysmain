# =============================================================================
# Frebys Fashion GH — .env.local example
# =============================================================================
# Copy to `.env.local` and fill in real values.
# NEXT_PUBLIC_* vars are baked into the client bundle — never put secrets there.
# =============================================================================

# --- Plain Postgres cutover (Shape A) — set these together in Coolify ---
DATABASE_URL=
# POSTGRES_URL=   # optional alias
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_LOCK_TIMEOUT_MS=10000
# PG_IDLE_IN_TX_TIMEOUT_MS=60000
# PGSSL=require   # only if TLS required to Postgres
NEXT_PUBLIC_USE_PLAIN_PG=true
# Must be the *app origin* after cutover (not *.supabase.co):
NEXT_PUBLIC_SUPABASE_URL=https://www.frebysfashion.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_JWT_SECRET=
# JWT_SECRET=     # optional alias used by some helpers
STORAGE_ROOT=
STORAGE_PUBLIC_URL=

# Legacy hosted Supabase (only needed before cutover / scripts)
# SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://www.frebysfashion.com
ADMIN_EMAIL=info@frebysfashion.com
CONTACT_PHONE=0244720197
NEWSLETTER_PROMO_CODE=INSIDER10

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@frebysfashion.com

# Moolre (backup Mobile Money gateway)
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=
MOOLRE_CALLBACK_SECRET=
MOOLRE_SMS_API_KEY=
SMS_SENDER_ID=Frebys Kids

# Hubtel (primary Mobile Money gateway)
# HUBTEL_MERCHANT_ACCOUNT_NUMBER = merchant ID in the public RMSC status URL
# (e.g. .../merchants/2039884/transactions/status?clientReference=...)
NEXT_PUBLIC_ENABLE_HUBTEL=false
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# AI Chat (optional)
GROQ_API_KEY=
NEXT_PUBLIC_CHAT_ENABLED=true

# Cron (optional)
CRON_SECRET=

# reCAPTCHA (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Meta Pixel + Conversions API (optional)
# Pixel ID is public; Access Token must stay server-only (Coolify secret).
NEXT_PUBLIC_META_PIXEL_ID=2113049835944449
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test Events code while verifying
# META_CAPI_TEST_EVENT_CODE=TEST12345
